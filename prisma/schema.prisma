generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  TENANT
  OWNER
  LANDLORD
  AGENT
  PROPERTY_MANAGER
  DEVELOPER
  ADMIN
}

enum ListingType {
  RENT
  SALE
  SHORT_TERM_RENT
  LONG_TERM_RENT
  LEASE
}

enum MeasurementUnit {
  SQUARE_METERS
  SQUARE_FEET
  ACRES
  HECTARES
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  PUBLISHED
  PAUSED
  RENTED
  SOLD
  SUSPENDED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATING
  CLOSED
}

enum ViewingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentType {
  VIEWING_FEE
  BOOKING_FEE
  RENT
  DEPOSIT
  PLATFORM_FEE
  SALE
  LEASE
  SHORT_TERM_RENT
}

enum CommissionPayer {
  SELLER
  BUYER
  SHARED
}

enum FinancialTransactionStatus {
  QUOTED
  PENDING_PAYMENT
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  CANCELLED
}

enum PayoutStatus {
  NOT_DUE
  PENDING
  PROCESSING
  PAID
  FAILED
  HELD
}

enum PayoutAccountStatus {
  PENDING
  VERIFIED
  REJECTED
  DISABLED
}

enum MonetizationProductType {
  SUBSCRIPTION
  FEATURED_LISTING
  QUALIFIED_LEAD
}

enum BillingInterval {
  ONE_TIME
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  FAILED
}

enum MonetizationOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum FinancialAuditAction {
  COMMISSION_RULE_CREATED
  COMMISSION_RULE_UPDATED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  FINANCIAL_STATUS_CHANGED
  REFUND_RECORDED
  DISPUTE_UPDATED
  PAYOUT_UPDATED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum UserVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum NotificationType {
  ENQUIRY
  VIEWING
  PAYMENT
  PROPERTY
  MESSAGE
  SYSTEM
  CALL
  LIVE_TOUR
}

enum CallType {
  VIDEO_CALL
  LIVE_TOUR
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
  CANCELLED
}

model User {
  id                String                    @id @default(cuid())
  name              String
  email             String                    @unique
  passwordHash      String
  phone             String?
  profileImage      String?
  role              UserRole                  @default(USER)
  countryCode       String?                   @db.VarChar(2)
  regionId          String?
  cityId            String?
  preferredCurrency String                    @default("NGN") @db.VarChar(3)
  preferredLanguage String                    @default("en") @db.VarChar(12)
  measurementUnit   MeasurementUnit           @default(SQUARE_METERS)
  timeZone          String?                   @db.VarChar(80)
  verificationStatus UserVerificationStatus   @default(UNVERIFIED)
  lastSeenAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  profile           Profile?
  sessions          Session[]
  favorites         Favorite[]
  savedSearches     SavedSearch[]
  enquiries         Enquiry[]                 @relation("EnquirySeekers")
  messages          Message[]
  conversations     ConversationParticipant[]
  payments          Payment[]
  notifications     Notification[]
  verifications     Verification[]
  ownedProperties   Property[]                @relation("OwnedProperties")
  managedProperties Property[]                @relation("ManagedProperties")
  requestedViewings Viewing[]                 @relation("ViewingRequesters")
  tenants           Tenant[]
  agentProfile      AgentProfile?
  authoredReviews   Review[]
  reports           Report[]
  passwordResetTokens PasswordResetToken[]
  messageDeletions  MessageDeletion[]
  country           Country?                  @relation("UserCountry", fields: [countryCode], references: [code], onDelete: SetNull)
  region            Region?                    @relation("UserRegion", fields: [regionId], references: [id], onDelete: SetNull)
  city              City?                     @relation("UserCity", fields: [cityId], references: [id], onDelete: SetNull)
  preferredCurrencyData Currency               @relation("UserPreferredCurrency", fields: [preferredCurrency], references: [code], onDelete: Restrict)
  callsStarted      CallSession[]              @relation("CallInitiator")
  callParticipations CallParticipant[]
  callMessages      CallChatMessage[]
  financialTransactionsAsBuyer FinancialTransaction[] @relation("FinancialTransactionBuyer")
  financialTransactionsAsSeller FinancialTransaction[] @relation("FinancialTransactionSeller")
  financialTransactionsAsAgent FinancialTransaction[] @relation("FinancialTransactionAgent")
  payouts            Payout[]
  subscriptions      UserSubscription[]
  featuredListings   FeaturedListing[]
  purchasedLeads     LeadPurchase[]
  financialAuditLogs FinancialAuditLog[]
  createdRefunds     TransactionRefund[]
  payoutAccount      PayoutAccount?
  approvedPayouts    Payout[]                  @relation("PayoutApprover")

  @@index([countryCode, regionId, cityId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id      String  @id @default(cuid())
  userId  String  @unique
  bio     String?
  avatar  String?
  city    String?
  state   String?
  country String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id         String     @id @default(cuid())
  country    String
  state      String
  city       String
  area       String
  address    String
  postalCode String?
  latitude   Float?
  longitude  Float?
  countryCode String?   @db.VarChar(2)
  regionId   String?
  cityId     String?
  hideExactAddress Boolean @default(false)
  countryRecord Country? @relation(fields: [countryCode], references: [code], onDelete: SetNull)
  regionRecord Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  cityRecord  City?      @relation(fields: [cityId], references: [id], onDelete: SetNull)
  properties Property[]

  @@index([state, city, area])
  @@index([countryCode, regionId, cityId])
  @@index([latitude, longitude])
}

model Country {
  code               String      @id @db.VarChar(2)
  name               String
  nativeCurrencyCode String?     @db.VarChar(3)
  currency           Currency?   @relation("CountryCurrency", fields: [nativeCurrencyCode], references: [code], onDelete: SetNull)
  regions            Region[]
  locations          Location[]
  users              User[]      @relation("UserCountry")
  cities             City[]

  @@index([name])
}

model Region {
  id          String     @id @default(cuid())
  countryCode String     @db.VarChar(2)
  name        String
  code        String?
  country     Country    @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  cities      City[]
  locations   Location[]
  users       User[]      @relation("UserRegion")

  @@unique([countryCode, name])
  @@unique([countryCode, code])
  @@index([countryCode])
}

model City {
  id          String     @id @default(cuid())
  countryCode String     @db.VarChar(2)
  regionId    String
  name        String
  country     Country    @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  region      Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  locations   Location[]
  users       User[]     @relation("UserCity")

  @@unique([regionId, name])
  @@index([countryCode, name])
}

model Currency {
  code          String     @id @db.VarChar(3)
  name          String
  minorUnits    Int        @default(2)
  countries     Country[]  @relation("CountryCurrency")
  properties    Property[]
  payments      Payment[]
  preferredBy   User[]     @relation("UserPreferredCurrency")
  commissionRules CommissionRule[]
  financialProducts MonetizationProduct[]
  financialTransactions FinancialTransaction[]
  payouts       Payout[]
  refunds       TransactionRefund[]
  payoutAccounts PayoutAccount[]

  @@index([name])
}

model PayoutAccount {
  id                  String              @id @default(cuid())
  userId              String              @unique
  countryCode         String              @db.VarChar(2)
  currencyCode        String              @db.VarChar(3)
  bankCode            String
  bankName            String
  accountNumberLast4  String              @db.VarChar(4)
  accountNumberCipher String
  accountName         String
  provider            String              @default("PAYSTACK")
  recipientCode       String?             @unique
  status              PayoutAccountStatus @default(PENDING)
  verifiedAt          DateTime?
  disabledAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency            Currency            @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  payouts             Payout[]

  @@index([status, createdAt])
}

model PropertyType {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  properties Property[]
}

model Property {
  id            String            @id @default(cuid())
  slug          String            @unique
  title         String
  description   String
  listingType   ListingType
  type          String
  price         Decimal           @db.Decimal(14, 2)
  currencyCode  String            @default("NGN") @db.VarChar(3)
  propertyTypeId String?
  bedrooms      Int
  bathrooms     Int
  size          Decimal           @db.Decimal(14, 2)
  sizeUnit      MeasurementUnit   @default(SQUARE_METERS)
  furnished     Boolean?
  parkingSpaces Int?
  hasPool       Boolean           @default(false)
  hasSecurity   Boolean           @default(false)
  yearBuilt     Int?
  viewCount     Int               @default(0)
  status        PropertyStatus    @default(DRAFT)
  verified      Boolean           @default(false)
  featured      Boolean           @default(false)
  luxury        Boolean           @default(false)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  ownerId       String
  agentId       String?
  locationId    String
  owner         User              @relation("OwnedProperties", fields: [ownerId], references: [id], onDelete: Restrict)
  agent         User?             @relation("ManagedProperties", fields: [agentId], references: [id], onDelete: SetNull)
  location      Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  currency      Currency          @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  propertyType  PropertyType?     @relation(fields: [propertyTypeId], references: [id], onDelete: SetNull)
  media         PropertyMedia[]
  amenities     PropertyAmenity[]
  favorites     Favorite[]
  savedSearches SavedSearch[]
  enquiries     Enquiry[]
  conversations Conversation[]
  payments      Payment[]
  viewings      Viewing[]
  reviews       Review[]
  tenants       Tenant[]
  verifications Verification[]
  reports       Report[]
  callSessions  CallSession[]
  financialTransactions FinancialTransaction[]
  featuredListingOrders FeaturedListing[]

  @@index([status, listingType, type])
  @@index([price])
  @@index([currencyCode, price])
  @@index([propertyTypeId])
  @@index([status, listingType, createdAt])
  @@index([status, luxury, createdAt])
  @@index([sizeUnit, size])
  @@index([bedrooms, bathrooms])
  @@index([yearBuilt])
  @@index([furnished, hasPool, hasSecurity])
  @@index([ownerId, viewCount])
  @@index([ownerId])
  @@index([agentId])
  @@index([locationId])
}

model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String
  url        String
  type       MediaType
  isCover    Boolean   @default(false)
  order      Int       @default(0)
  fileName   String?
  mimeType   String?
  size       Int?
  publicId   String?
  resourceType String?
  createdAt  DateTime  @default(now())
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, order])
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name])
  @@index([name])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

model SavedSearch {
  id         String    @id @default(cuid())
  userId     String
  propertyId String?
  name       String
  filters    Json
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id           String                    @id @default(cuid())
  propertyId   String?
  pairKey      String?                   @unique
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  property     Property?                 @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([propertyId])
  @@index([updatedAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  replyToId      String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  attachments    MessageAttachment[]
  deletions      MessageDeletion[]

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@index([replyToId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileName  String
  mimeType  String
  size      Int
  url       String
  publicId  String?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model CallSession {
  id          String          @id @default(cuid())
  propertyId  String
  initiatorId String
  roomName    String          @unique
  type        CallType
  status      CallStatus      @default(RINGING)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  initiator   User            @relation("CallInitiator", fields: [initiatorId], references: [id], onDelete: Restrict)
  participants CallParticipant[]
  messages    CallChatMessage[]

  @@index([propertyId, status, createdAt])
  @@index([initiatorId, createdAt])
}

model CallParticipant {
  callId   String
  userId   String
  status   String   @default("INVITED")
  joinedAt DateTime?
  leftAt   DateTime?
  call     CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId, status])
}

model CallChatMessage {
  id        String     @id @default(cuid())
  callId    String
  senderId  String
  content   String
  createdAt DateTime   @default(now())
  call      CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([callId, createdAt])
}

model MessageDeletion {
  messageId String
  userId    String
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, deletedAt])
}

model Enquiry {
  id         String        @id @default(cuid())
  userId     String
  propertyId String
  message    String
  contact    String?
  status     EnquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation("EnquirySeekers", fields: [userId], references: [id], onDelete: Restrict)
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadPurchases LeadPurchase[]

  @@index([propertyId, status])
  @@index([userId, createdAt])
}

model Viewing {
  id            String        @id @default(cuid())
  propertyId    String
  requesterId   String
  scheduledAt   DateTime?
  preferredDate DateTime
  preferredTime String
  message       String?
  status        ViewingStatus @default(REQUESTED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requester     User          @relation("ViewingRequesters", fields: [requesterId], references: [id], onDelete: Restrict)

  @@index([propertyId, preferredDate, preferredTime])
  @@index([propertyId, scheduledAt, status])
  @@index([requesterId, status])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  propertyId  String?
  amount      Decimal       @db.Decimal(14, 4)
  currency    String        @default("NGN")
  provider    String        @default("PAYSTACK")
  reference   String        @unique
  providerReference String?
  processorTransactionId String? @unique
  status      PaymentStatus @default(PENDING)
  paymentType PaymentType
  paymentDate DateTime?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  property    Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  currencyData Currency    @relation(fields: [currency], references: [code], onDelete: Restrict)
  financialTransaction FinancialTransaction?

  @@index([userId, status])
  @@index([propertyId])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  outcome     String
  receivedAt  DateTime @default(now())
  processedAt DateTime @default(now())

  @@index([eventType, processedAt])
  @@map("StripeWebhookEvent")
}

model CommissionRule {
  id                       String         @id @default(cuid())
  name                     String
  transactionType          PaymentType?
  countryCode              String?        @db.VarChar(2)
  propertyTypeCode         String?
  currencyCode             String?        @db.VarChar(3)
  percentageRate           Decimal        @default(0) @db.Decimal(7, 4)
  fixedFee                 Decimal        @default(0) @db.Decimal(14, 4)
  processingFeeRate        Decimal        @default(0) @db.Decimal(7, 4)
  processingFeeFixed       Decimal        @default(0) @db.Decimal(14, 4)
  payer                    CommissionPayer @default(SELLER)
  active                   Boolean        @default(true)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  currency                 Currency?      @relation(fields: [currencyCode], references: [code], onDelete: SetNull)
  transactions             FinancialTransaction[]

  @@index([active, transactionType, countryCode, propertyTypeCode, currencyCode])
}

model FinancialTransaction {
  id                       String                     @id @default(cuid())
  reference                String                     @unique
  buyerId                  String
  sellerId                 String
  agentId                  String?
  propertyId               String?
  paymentId                String?                    @unique
  commissionRuleId         String?
  transactionType          PaymentType
  status                   FinancialTransactionStatus @default(QUOTED)
  amount                   Decimal                    @db.Decimal(14, 4)
  currencyCode             String                     @db.VarChar(3)
  countryCode              String?                    @db.VarChar(2)
  commissionPayer          CommissionPayer            @default(SELLER)
  commissionRate           Decimal                    @default(0) @db.Decimal(7, 4)
  commissionFixedFee       Decimal                    @default(0) @db.Decimal(14, 4)
  platformCommission       Decimal                    @default(0) @db.Decimal(14, 4)
  buyerPlatformFee          Decimal                    @default(0) @db.Decimal(14, 4)
  sellerCommission          Decimal                    @default(0) @db.Decimal(14, 4)
  processingFeeRate         Decimal                    @default(0) @db.Decimal(7, 4)
  processingFeeFixed        Decimal                    @default(0) @db.Decimal(14, 4)
  paymentProcessingFee       Decimal                    @default(0) @db.Decimal(14, 4)
  totalBuyerDue              Decimal                    @default(0) @db.Decimal(14, 4)
  sellerAmount              Decimal                    @default(0) @db.Decimal(14, 4)
  finalPayout               Decimal                    @default(0) @db.Decimal(14, 4)
  payoutStatus              PayoutStatus               @default(NOT_DUE)
  payoutDueAt               DateTime?
  paidAt                    DateTime?
  refundedAt                DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  buyer                     User                       @relation("FinancialTransactionBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller                    User                       @relation("FinancialTransactionSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  agent                     User?                      @relation("FinancialTransactionAgent", fields: [agentId], references: [id], onDelete: SetNull)
  property                  Property?                  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  payment                   Payment?                   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  commissionRule            CommissionRule?            @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  currency                  Currency                   @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  payouts                   Payout[]
  refunds                   TransactionRefund[]
  disputes                  TransactionDispute[]

  @@index([buyerId, createdAt])
  @@index([sellerId, payoutStatus, createdAt])
  @@index([agentId, payoutStatus, createdAt])
  @@index([propertyId, createdAt])
  @@index([status, currencyCode, createdAt])
  @@index([paidAt, currencyCode])
}

model Payout {
  id                  String       @id @default(cuid())
  transactionId       String       @unique
  recipientId         String
  payoutAccountId     String?
  amount              Decimal      @db.Decimal(14, 4)
  currencyCode        String       @db.VarChar(3)
  status              PayoutStatus @default(PENDING)
  provider            String?
  providerReference   String?      @unique
  transferCode        String?      @unique
  processorTransferId String?      @unique
  approvedAt          DateTime?
  approvedById        String?
  failureReason       String?
  attempts            Int          @default(0)
  lastAttemptAt       DateTime?
  nextRetryAt         DateTime?
  requestedAt         DateTime     @default(now())
  completedAt         DateTime?
  updatedAt           DateTime     @updatedAt
  transaction         FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  recipient           User         @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  approvedBy          User?        @relation("PayoutApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  currency            Currency     @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  payoutAccount       PayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)

  @@index([recipientId, status, requestedAt])
  @@index([status, nextRetryAt])
  @@index([status, approvedAt])
}

model TransactionRefund {
  id            String       @id @default(cuid())
  transactionId String
  amount        Decimal       @db.Decimal(14, 4)
  currencyCode  String       @db.VarChar(3)
  reason        String
  status        MonetizationOrderStatus @default(PENDING)
  providerReference String?
  createdById   String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  currency      Currency     @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([transactionId, status, createdAt])
}

model TransactionDispute {
  id            String       @id @default(cuid())
  transactionId String
  providerReference String?
  status        String       @default("OPEN")
  reason        String?
  resolution    String?
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@unique([transactionId])
}

model MonetizationProduct {
  id            String                  @id @default(cuid())
  code          String                  @unique
  name          String
  description   String
  type          MonetizationProductType
  billingInterval BillingInterval       @default(ONE_TIME)
  price         Decimal                 @db.Decimal(14, 4)
  currencyCode  String                  @db.VarChar(3)
  durationDays  Int?
  listingLimit  Int?
  features      Json                    @default("[]")
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  currency      Currency                @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  subscriptions UserSubscription[]
  promotions    FeaturedListing[]
  leads         LeadPurchase[]

  @@index([type, active, currencyCode])
}

model UserSubscription {
  id                  String            @id @default(cuid())
  userId              String
  productId           String
  status              SubscriptionStatus @default(PENDING)
  billingInterval     BillingInterval
  priceAtPurchase     Decimal           @db.Decimal(14, 4)
  currencyCode        String            @db.VarChar(3)
  provider            String?
  providerReference   String?
  startedAt           DateTime?
  currentPeriodEnd    DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  product             MonetizationProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, status, currentPeriodEnd])
}

model FeaturedListing {
  id                String              @id @default(cuid())
  propertyId        String
  purchaserId       String
  productId         String
  status            MonetizationOrderStatus @default(PENDING)
  priceAtPurchase   Decimal             @db.Decimal(14, 4)
  currencyCode      String              @db.VarChar(3)
  startsAt          DateTime?
  expiresAt         DateTime?
  providerReference String?
  createdAt         DateTime            @default(now())
  property          Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  purchaser         User                @relation(fields: [purchaserId], references: [id], onDelete: Restrict)
  product           MonetizationProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([propertyId, status, expiresAt])
  @@index([purchaserId, status, createdAt])
}

model LeadPurchase {
  id                String              @id @default(cuid())
  purchaserId       String
  productId         String
  enquiryId         String
  status            MonetizationOrderStatus @default(PENDING)
  priceAtPurchase   Decimal             @db.Decimal(14, 4)
  currencyCode      String              @db.VarChar(3)
  providerReference String?
  createdAt         DateTime            @default(now())
  purchaser         User                @relation(fields: [purchaserId], references: [id], onDelete: Restrict)
  product           MonetizationProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  enquiry           Enquiry             @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  @@unique([purchaserId, enquiryId])
  @@index([purchaserId, status, createdAt])
}

model FinancialAuditLog {
  id          String              @id @default(cuid())
  actorId     String?
  action      FinancialAuditAction
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  reason      String
  createdAt   DateTime            @default(now())
  actor       User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  contactInfo    String
  propertyId     String
  leaseStartDate DateTime
  leaseEndDate   DateTime
  rentAmount     Decimal  @db.Decimal(14, 2)
  paymentStatus  String   @default("CURRENT")
  notes          String?
  userId         String?
  createdAt      DateTime @default(now())
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  leases         Lease[]

  @@index([propertyId, leaseEndDate])
}

model Lease {
  id            String   @id @default(cuid())
  tenantId      String
  startDate     DateTime
  endDate       DateTime
  rentAmount    Decimal  @db.Decimal(14, 2)
  paymentStatus String   @default("CURRENT")
  documents     Json?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, endDate])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model AgentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  company   String?
  licenceNo String?
  verified  Boolean  @default(false)
  rating    Float    @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id          String             @id @default(cuid())
  userId      String
  propertyId  String?
  type        String
  status      VerificationStatus @default(PENDING)
  documentUrl String?
  notes       String?
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property?          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([userId, status])
}

model Review {
  id         String   @id @default(cuid())
  propertyId String
  authorId   String
  rating     Int
  comments   String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([propertyId, authorId])
  @@index([propertyId, rating])
}

model Report {
  id         String    @id @default(cuid())
  propertyId String?
  userId     String?
  reason     String
  details    String?
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([propertyId])
}
